;-----------------------------------------------------------------------------
;
; This is the "corrected" IL implementation of Tiny BASIC from January 1976
; with some additional corrections to fix some bugs.
;
; https://archive.org/details/dr_dobbs_journal_vol_01
;
;-----------------------------------------------------------------------------
;
; Language grammar:
;
; line ::= number statement <CR> | statement <CR>
; statement ::=
;       "PRINT" expr-list
;     | "IF" expression relop expression THEN statement
;     | "GOTO" expression
;     | "INPUT" var-list
;     | "LET" var "=" expression
;     | "GOSUB" expression
;     | "RETURN"
;     | "CLEAR"         ; Equivalent to "NEW" in other BASIC's
;     | "LIST"
;     | "RUN"
;     | "END"
; expr-list ::= (string | expression) ("," (string | expression))*
; var-list ::= var ("," var)*
; expression ::= ["+" | "-"] term (("+" | "-") term)*
; term ::= factor (("*" | "/") factor)*
; factor ::= var | number | "(" expression ")"
; var ::= "A" | "B" | "C" | ... | "Y" | "Z"
; number ::= digit digit*
; digit ::= "0" | "1" | "2" | ... | "8" | "9"
; relop ::= "<" | "<=" | "<>" | ">" | ">=" | "><" | "="
; string ::= '"' (any character except " or <CR>)* '"'
;
;-----------------------------------------------------------------------------
;
; IL instructions make use of three stacks.  The "control stack" is used
; for subroutine calls within IL.  "SUBSTK" keeps track of return
; points for "GOSUB" and "RETURN".  "AESTK" is the arithmetic expression
; stack and keeps in-progress numeric values during expression evaluation.
;
; TST label / DB string
;       Skip leading blanks and check if the string matches the line.
;       If it does, then skip the matched string and proceed with the
;       next instruction.  Otherwise jump to "label".  If "label"
;       points to the same "TST" instruction, then a syntax error
;       will be reported if the code does not match the string.
;       The "DB" string encoding below sets the high bit of the last
;       character to 1 to indicate end of string without a separate NUL.
; CALL label
;       Call the IL subroutine at "label".  Note: the original code used
;       "ICALL" because IL was generated by macros in the Intel assembler.
;       "CALL" was already in use as an Intel instruction.
; RTN
;       Return to the IL routine that called this subroutine.
; DONE
;       Skip leading blanks.  Report a syntax error if not at end of line.
; JMP label
; HOP label
;       Jump to the IL code at "label".  Sometimes the code below uses
;       "JMP" and sometimes "HOP".  "HOP" may have been used for shorter
;       jumps that could be expressed with a small relative offset and
;       "JMP" for longer jumps.  Note: the original code uses "IJMP"
;       for the "JMP" instruction (see the description of "CALL" above).
; GETLN
;       Get a line of input from the terminal, terminated by a CR.
; PRS
;       Print all characters up to the next double quote ".  If the end of
;       line is encountered, then report an error.
; PRN
;       Print the number on the top of the AESTK.
; SPC
;       Insert spaces to move the print head to the next zone / tab stop.
; NLINE
;       Output CRLF to the printer.
; NXT
;       If in direct mode, then return to the line collection routine at "C0".
;       Otherwise select the next line and continue IL execution from "STMT".
; RNXT
;       Select the first line in the program and start execution (for "RUN").
;       Note: The original Tiny BASIC code used "NXT" for "RUN" but it is
;       unclear how that would work.  The IL code had not at that point
;       selected a line to execute from.  This version uses "RNXT" instead.
; XFER
;       Verify that the top of the AESTK is a valid line number and then
;       continue execution from there (for "GOTO" and "GOSUB").  Report an
;       error if invalid.
; SAV
;       Places the current line on SUBSTK (the BASIC subroutine stack).
; RSTR
;       Restore the current line from the top of SUBSTK.  Report an
;       error if SUBSTK is empty.
; CMPR
;       Pops the top three items from AESTK as A, R, and B from bottom-up.
;       R is a relational operator to indicate what type of comparison to
;       perform (see "RELOP" below).  If the result of the comparison is
;       false, then perform an implicit "NXT".
; INNUM
;       Read a number from the input and push it onto the AESTK.
; FIN
;       Return to the line collection routine (for "END").
; ERR
;       Report a syntax error and return to the line collection routine.
;       Note: This is not actually used by the code below.
; ADD
;       Replace the top two elements on AESTK with their sum.
; SUB
;       Replace the top two elements on AESTK with their difference.
; NEG
;       Replace the top element on AESTK with its negation.
; MUL
;       Replace the top two elements on AESTK with their product.
; DIV
;       Replace the top two elements on AESTK with their quotient.
; LIT n
;       Push the literal value n onto AESTK.
; STORE
;       Store the value at the top of AESTK to the variable whose index is
;       given just below the value on the AESTK.
; TSTV label
;       Test for a variable at the next program location.  If it is a
;       variable, push its index onto the AESTK, and continue execution
;       after the "TSTV" instruction.  Otherwise continue IL execution
;       from "label".
; TSTN label
;       Test for a number at the next program location.  If it is a
;       number, push its value onto the AESTK, and continue execution
;       after the "TSTN" instruction.  Otherwise continue IL execution
;       from "label".
; INSRT
;       Insert the current line in the input buffer into the program
;       storage area after removing any existing line with the same number.
; TSTL label
;       Test for a line number at the next program location.  If it is a
;       valid line number, then continue execution with the next instruction.
;       Otherwise continue IL execution from "label".
; INIT
;       Initialize the program storage area to empty and clear all variables.
; XINIT
;       Initialize for execution of the next statement.  Empties AESTK.
; LST
;       Type out the entire BASIC program.
;
;-----------------------------------------------------------------------------
;
; Error codes:
;
;   1   Syntax error
;   2   Missing line                (GOTO or GOSUB to non-existent line number)
;   3   Line number too large
;   4   Too many GOSUBs             (SUBSTK overflow)
;   5   RETURN without GOSUB        (SUBSTK underflow)
;   6   Expression too complex      (AESTK or control stack overflow)
;   7   Too many lines              (Program storage area is full)
;   8   Division by zero
;
;-----------------------------------------------------------------------------
;
; Statement executor written in IL (Interpretive Language)
;
; Control Section
;
START:      INIT                ; Initialize
ERRENT:     NLINE               ; Write a CR-LF
C0:         GETLN               ; Write prompt and get a line
            TSTL    XEC         ; If no line number, go execute it
            INSRT               ; Insert or delete the line
            JMP     C0          ; Loop for another line
XEC:        XINIT               ; Initialize for execution
;
;
; Statement Executor
;
STMT:       TST     S1          ; Check for 'LET'
            DB      'LE','T' OR 200O
SE1:        TSTV    SE1         ; Error if no variable!
SE2:        TST     SE2         ; Error if no "="
            DB      '=' OR 200O
            CALL    EXPR        ; Put expression on AESTK
            DONE                ; Check for CR line terminator
            STORE               ; Put value of expression in its cell
            NXT                 ; Continue next line
;
;
S1:         TST     S3          ; Check for 'GO'
            DB      'G','O' OR 200O
            TST     S2          ; Check for 'GOTO'
            DB      'T','O' OR 200O
            CALL    EXPR        ; Get the label
            DONE                ; Check for CR line terminator
            XFER                ; Do a 'GOTO' to the label
;
;
S2:         TST     S2          ; Check for 'GOSUB', failure is an error!
            DB      'SU','B' OR 200O
            CALL    EXPR        ; Put expression on AESTK
            DONE                ; Check for CR line terminator
            SAV                 ; Save next line number in BASIC text
            XFER                ; Do a 'GOSUB' to the label
;
;
S3:         TST     S8          ; Check for 'PRINT'
            DB      'PRIN','T' OR 200O
S4:         TST     S7          ; Check for " to begin a string
            DB      '"' OR 200O
            PRS                 ; Print the data enclosed in quotes
S5:         TST     S6          ; ',' means more to come
            DB      ',' OR 200O
            SPC                 ; Space to next zone
            HOP     S4          ; Go back for more
S6:         DONE                ; Check for CR line terminator
            NLINE               ; Write a CR-LF
            NXT                 ; Continue next line
S7:         CALL    EXPR        ; Get the numeric value to print
            PRN                 ; Print the number
            HOP     S4          ; Go back for more
;
;
S8:         TST     S9          ; Check for 'IF'
            DB      'I','F' OR 200O
            CALL    EXPR        ; Get the first expression
            CALL    RELOP       ; Get the relational operator
            CALL    EXPR        ; Get the second expression
S8A:        TST     S8A         ; Check for 'THEN'
            DB      'THE','N' OR 200O
            CMPR                ; If not true continue next line
            JMP     STMT        ; If true process the rest of this line
;
;
S9:         TST     S12         ; Check for 'INPUT'
            DB      'INPU','T' OR 200O
S10:        CALL    VAR         ; Get the variable's index
            INNUM               ; Get the number from the teletype
            STORE               ; Put the value of the variable in its cell
            TST     S11         ; ',' means more data
            DB      ',' OR 200O
S11:        DONE                ; Check for CR line terminator
            NXT                 ; Continue next line
;
;
S12:        TST     S13         ; Check for 'RETURN'
            DB      'RETUR','N' OR 200O
            DONE                ; Check for CR line terminator
            RSTR                ; Return to caller
;
;
S13:        TST     S14         ; Check for 'END'
            DB      'EN','D' OR 200O
            FIN                 ; Go back to control mode
;
;
S14:        TST     S15         ; Check for 'LIST'
            DB      'LIS','T' OR 200O
            DONE                ; Check for CR line terminator
            LST                 ; Type out the BASIC program
            NXT                 ; Continue next line
;
;
S15:        TST     S16         ; Check for 'RUN'
            DB      'RU','N' OR 200O
            DONE                ; Check for CR line terminator
            RNXT                ; Select the first program line and execute it
;
;
S16:        TST     S16         ; Check for 'CLEAR'
            DB      'CLEA','R' OR 200O
            JMP     START       ; Reinitialize everything!
;
; ***
;
; Interpretive language subroutines
;
EXPR:       TST     E0          ; Test for unary '-'
            DB      '-' OR 200O
            CALL    TERM        ; Put term on AESTK
            NEG                 ; Negate value on AESTK
            HOP     E1          ; Go get a term
;
E0:         TST     E01         ; Test for unary '+'
            DB      '+' OR 200O
E01:        CALL    TERM        ; Put term on AESTK
E1:         TST     E2          ; Test for addition
            DB      '+' OR 200O
            CALL    TERM        ; Get second term
            ADD                 ; Put sum of terms on AESTK
            HOP     E1          ; Loop around for more
;
E2:         TST     E3          ; Test for subtraction
            DB      '-' OR 200O
            CALL    TERM        ; Get second term
            SUB                 ; Put difference of terms on AESTK
            HOP     E1          ; Loop around for more
;
E3:         RTN                 ; This can be recursive
;
;
;
TERM:       CALL    FACT        ; Get one factor
T0:         TST     T1          ; Test for multiplication
            DB      '*' OR 200O
            CALL    FACT        ; Get a factor
            MPY                 ; Put the product on AESTK
            HOP     T0          ; Loop around for more
;
T1:         TST     T2          ; Test for division
            DB      '/' OR 200O
            CALL    FACT        ; Get a factor
            DIV                 ; Put quotient on AESTK
            HOP     T0          ; Loop around for more
;
T2:         RTN                 ; Return to caller
;
;
;
FACT:       TSTV    F0          ; Test for variable
            IND                 ; Get index of the variable
            RTN
F0:         TSTN    F1          ; Test for number
            RTN
F1:         TST     F1          ; Error if its not a '('
            DB      '(' OR 200O
            CALL    EXPR        ; This is a recursive process
;
FE1:        TST     FE1         ; Every '(' has to have a ')'
            DB      ')' OR 200O
            RTN
;
; RELOP parses the relational operator that follows and returns
; one of the following comparison values depending on the operator:
;
;   0       Equal
;   1       Less than
;   2       Less than or equal
;   3       Not equal
;   4       Greater than
;   5       Greater than or equal
;
RELOP:      TST     R0          ; Check for '='
            DB      '=' OR 200O
            LIT     0
            RTN
;
R0:         TST     R4          ; Check for '<'
            DB      '<' OR 200O
            TST     R1          ; Check for '<='
            DB      '=' OR 200O
            LIT     2
            RTN
;
R1:         TST     R3          ; Check for '<>'
            DB      '>' OR 200O
            LIT     3
            RTN
;
R3:         LIT     1
            RTN
;
R4:         TST     R4          ; Check for '>'
            DB      '>' OR 200O
            TST     R5          ; Check for '>='
            DB      '=' OR 200O
            LIT     5
            RTN
;
R5:         TST     R6          ; Check for '><'
            DB      '<' OR 200O
            LIT     3
            RTN
;
R6:         LIT     4
            RTN
