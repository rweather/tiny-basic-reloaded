5 REM MANDELBROT FOR TINY BASIC RELOADED, FIXED-POINT SCALE = 2^9
10 FOR B = -573 TO 573 STEP 55:REM -1.12 to 1.12, STEP 0.1067
20 FOR A = -1024 TO 512 STEP 26:REM -2.00 to 1.00, STEP 0.0500
30 X=0:Y=0:I=0
40 S=FPMUL(X,X,9):T=FPMUL(Y,Y,9)
50 IF (S+T) > 2048 OR I >= 32 THEN 100
60 Z=S-T+A
70 Y=FPMUL(X+X,Y,9)+B
80 X=Z:I=I+1
90 GOTO 40
100 PRINT CHR$(64-I);
110 NEXT A:PRINT:NEXT B
